/* OpenShorts Fit / No Crop studio controls and 9:16 preview */
.fit-layout-options{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.fit-layout-options button{min-height:83px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:4px;border:1px solid #453851;border-radius:10px;background:#1b1724;color:#efebf7;padding:14px;text-align:left}
.fit-layout-options button.selected{border-color:#aa8dff;background:linear-gradient(130deg,#40305a,#241e31)}
.fit-layout-options button strong{font-size:12px}.fit-layout-options button small{font-size:10px;color:#af9fb9;line-height:1.35}
.fit-presets{display:flex;flex-wrap:wrap;gap:8px}.fit-presets button{background:#292136;border:1px solid #52405f;color:#e5d4ff;border-radius:7px;padding:8px 12px;font-size:11px}
.fit-presets button:hover{border-color:#ae86ff}.fit-panel-controls{padding:16px;border:1px solid #362b44;border-radius:11px;background:#16111d}
.fit-color-pickers{display:flex;gap:20px;margin-top:14px;flex-wrap:wrap}.fit-color-pickers label{display:flex;gap:12px;align-items:center;color:#b9a9c6;font-size:11px}.fit-color-pickers input{border:1px solid #594963;background:transparent;border-radius:7px;width:45px;height:37px;padding:3px;cursor:pointer}
.source-preview-stage{height:100%;width:100%;display:flex;align-items:center;justify-content:center}
.fit-preview-stage{height:100%;aspect-ratio:9/16;max-width:100%;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;box-shadow:0 0 30px #0009}
.fit-preview-stage video{position:relative;z-index:2;height:100%;width:100%;object-fit:contain}
.fit-preview-panel{position:absolute;left:0;right:0;z-index:1;pointer-events:none}.fit-preview-top{top:0}.fit-preview-bottom{bottom:0}
.video-canvas:has(.fit-preview-stage) .caption-preview{left:50%;right:auto;width:min(210px,78%);transform:translateX(-50%);z-index:3;font-size:13px!important}
.video-canvas .video-play-control{z-index:4}
@media(max-width:500px){.fit-layout-options{grid-template-columns:1fr}.fit-panel-controls{padding:12px}}
