'use client';
import React,{useCallback,useEffect,useState} from 'react';
import {Activity,AlertCircle,ArrowRight,CheckCircle2,Clock3,Film,LoaderCircle,Play,Radio,Scissors,Square,Video} from 'lucide-react';
import {post,request} from '@/lib/api';

type LiveSession={id:string;url:string;label:string;state:string;message:string;chunks:number;project_ids:string[];auto_export:number;started_at:string;updated_at:string};
const running=(s:LiveSession)=>['starting','waiting','recording','analyzing'].includes(s.state);
const stateLabel=(s:string)=>({starting:'Connecting',waiting:'Waiting for live',recording:'Capturing livestream',analyzing:'Finding highlights',stopped:'Stopped',failed:'Needs attention'} as Record<string,string>)[s]||s;
export default function LiveHighlights(){
 const [url,setUrl]=useState('');const [label,setLabel]=useState('My livestream');const [seconds,setSeconds]=useState(120);const [autoExport,setAutoExport]=useState(true);
 const [sessions,setSessions]=useState<LiveSession[]>([]);const [loading,setLoading]=useState(true);const [saving,setSaving]=useState(false);const [error,setError]=useState('');
 const refresh=useCallback(async()=>{try{const data=await request<LiveSession[]>('/live');setSessions(data);setError('')}catch(e){setError((e as Error).message)}finally{setLoading(false)}},[]);
 useEffect(()=>{void refresh();const id=setInterval(()=>{void refresh()},4000);return()=>clearInterval(id)},[refresh]);
 async function start(e:React.FormEvent){e.preventDefault();setSaving(true);setError('');try{await post('/live',{url,label,chunk_seconds:seconds,auto_export:autoExport});await refresh()}catch(e){setError((e as Error).message)}finally{setSaving(false)}}
 async function stop(id:string){setSaving(true);try{await post('/live/'+id+'/stop',{});await refresh()}catch(e){setError((e as Error).message)}finally{setSaving(false)}}
 const active=sessions.find(running);
 return <div className="live-container">
  <div className="dashboard-header"><div><div className="dash-breadcrumb">WORKSPACE / LIVE HIGHLIGHTS</div><h1>Capture the moment <span className="live-violet">as it happens.</span></h1><p>Follow an authorized YouTube livestream, find standout moments, and prepare Shorts while the broadcast runs.</p></div><span className="live-eyebrow"><Radio size={16}/> LIVE STUDIO</span></div>
  <div className="live-studio-grid"><section className="live-card"><div className="live-section-head"><span className="live-icon"><Radio size={20}/></span><div><h2>Connect a livestream</h2><p>Use a live video link or a channel /live page.</p></div></div>
   <form onSubmit={start} className="live-form">
    <label htmlFor="live-url">YouTube live URL</label><input id="live-url" type="url" required pattern="https://.*" value={url} onChange={e=>setUrl(e.target.value)} placeholder="https://www.youtube.com/@YourChannel/live"/>
    <label htmlFor="live-label">Session name</label><input id="live-label" required maxLength={100} value={label} onChange={e=>setLabel(e.target.value)}/>
    <label htmlFor="live-chunk">Analysis window</label><select id="live-chunk" value={seconds} onChange={e=>setSeconds(Number(e.target.value))}><option value={60}>60 seconds · quicker results</option><option value={90}>90 seconds · balanced</option><option value={120}>120 seconds · more context</option></select>
    <label className="live-check"><input checked={autoExport} onChange={e=>setAutoExport(e.target.checked)} type="checkbox"/> Automatically export top-ranked clip from each recording</label>
    <button className="btn btn-primary btn-full" type="submit" disabled={saving||!!active||!url.trim()}>{saving?<LoaderCircle className="spin" size={18}/>:<Play size={17}/>} Start watching <ArrowRight size={16}/></button>
   </form><div className="live-note"><AlertCircle size={16}/> Only track streams you own or have explicit permission to record and repurpose. YouTube may restrict capture or authentication.</div>
  </section>
  <section className="live-card"><div className="live-section-head"><span className="live-icon"><Activity size={20}/></span><div><h2>Live monitor</h2><p>Real processing status — updated every 4 seconds.</p></div></div>
   {loading?<div className="live-empty"><LoaderCircle className="spin"/> Loading sessions</div>:active?<div className="live-active"><div className="live-dot"/><span>{stateLabel(active.state)}</span><strong>{active.label}</strong><p>{active.message}</p><div className="live-stat-row"><div><strong>{active.chunks}</strong><span>recordings analyzed</span></div><div><strong>{active.project_ids.length}</strong><span>saved projects</span></div></div><button className="btn btn-outline btn-full" disabled={saving} onClick={()=>stop(active.id)}><Square size={15}/> Stop monitoring</button></div>:<div className="live-empty"><Radio size={31}/><h3>No stream running</h3><p>Start an authorized livestream capture. Results will appear below when a recording is processed.</p></div>}
   <div className="live-note"><Clock3 size={16}/> Results are delayed by the capture window plus transcription, AI analysis and rendering. This is near-live, not instantaneous.</div>
  </section></div>
  {error&&<div className="form-error"><AlertCircle size={16}/>{error}</div>}
  <section className="live-history"><div className="live-history-heading"><div><h2>Captured highlights</h2><p>Each recording is a real OpenShorts project. Open it to review, trim, customize captions, or export.</p></div><button className="btn btn-outline btn-sm" onClick={()=>void refresh()}>Refresh</button></div>
   {sessions.length===0?<div className="live-empty live-saved-empty"><Film size={27}/><h3>Your live clips will show here.</h3></div>:
    <div className="live-records">{sessions.map(s=><article className="live-session" key={s.id}><div className="live-session-head"><span className={'live-state '+s.state}>{running(s)?<Radio size={15}/>:s.state==='failed'?<AlertCircle size={15}/>:<CheckCircle2 size={15}/>} {stateLabel(s.state)}</span><strong>{s.label}</strong><small>{new Date(s.started_at).toLocaleString()}</small></div><p>{s.message}</p>{s.project_ids.length?<div className="live-projects">{s.project_ids.map((pid,i)=><a className="live-project" key={pid} href={'/project/'+pid}><span><Video size={16}/> Recording #{i+1}</span><span>Open editor <Scissors size={14}/></span></a>)}</div>:<p className="live-muted">No recorded projects yet.</p>}</article>)}</div>}
  </section>
 </div>
}
