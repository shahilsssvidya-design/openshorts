# Local backend ONLY — do not commit, email or paste private feed URLs into chat.
# The API key must permit YouTube Data API v3 queries.
OPENSHORTS_YOUTUBE_API_KEY="PASTE_YOUR_API_KEY_HERE"

# Enable only for your own trusted local Mac. The background watcher and
# video recording remain disabled by default.
OPENSHORTS_LIVE_RECORDING_ENABLED="1"

# Optional, creator-authorized stable HTTPS/HLS source. Required ONLY for
# direct-feed capture mode. No URL is ever returned to the website.
# OPENSHORTS_AUTHORIZED_FEED_URL="https://creator.example/authorized/live.m3u8"

# Only needed for yt-dlp capture mode if the authorized source requires a
# local browser session. Beware Keychain prompts and cookie rotation.
# OPENSHORTS_LIVE_COOKIE_BROWSER="brave"

OPENSHORTS_WATCH_MAX_SEGMENTS="120"
OPENSHORTS_WATCH_MIN_FREE_GB="8"
