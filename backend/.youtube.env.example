# Google Cloud -> YouTube Data API v3 -> OAuth 2.0 Web application
# Configure this backend-only local file; NEVER paste it in frontend/.env.local.
# Use double quotes; do not put spaces around = signs.
OPENSHORTS_YOUTUBE_CLIENT_ID="PASTE_WEB_CLIENT_ID_HERE.apps.googleusercontent.com"
OPENSHORTS_YOUTUBE_CLIENT_SECRET="PASTE_CLIENT_SECRET_HERE"
OPENSHORTS_YOUTUBE_CALLBACK="http://localhost:8000/api/youtube/oauth/callback"
OPENSHORTS_FRONTEND_URL="http://localhost:3000"
